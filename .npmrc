@zytedata:registry=https://npm.pkg.github.com
auto-install-peers=true
# CI / publish auth: set NPM_CONFIG_//npm.pkg.github.com/:_authToken (env var)
# or write a separate ~/.npmrc locally; we deliberately don't reference
# ${GITHUB_TOKEN} here because pnpm warns when the env var is unset and we
# want clean local dev for engineers who only consume workspace deps.
