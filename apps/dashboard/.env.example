# apps/dashboard environment. Copy this file to `.env.local` (in this
# apps/dashboard directory — Next reads .env.local from the app dir, not the
# repo root) and fill in the values. `.env.local` is git-ignored and must
# never be committed.

# ─── Authentication (REQUIRED to start the app) ──────────────────────────────
# The dashboard is gated behind Google sign-in restricted to @zyte.com accounts
# (see knowledge/architecture/auth-model.md). All three are read via requireEnv()
# and the app throws on startup if any is unset.
AUTH_SECRET=            # secret used to sign/verify the zyte_session JWT (HS256)
GOOGLE_CLIENT_ID=       # Google OAuth 2.0 client id
GOOGLE_CLIENT_SECRET=   # Google OAuth 2.0 client secret

# ─── Markdown Studio (/products/<product>/studio) — AI providers (optional) ───
# Configure at least one provider to use the studio; the model picker only
# enables providers with a key set.

# OpenAI (GPT). Without it the OpenAI model returns a clear "not configured"
# message instead of streaming a reply.
OPENAI_API_KEY=

# Optional: override the OpenAI model (defaults to gpt-4o-mini).
# OPENAI_MODEL=gpt-4o-mini

# Anthropic (Claude). Enables the Claude option in the studio model picker.
ANTHROPIC_API_KEY=

# Optional: override the Claude model (defaults to claude-sonnet-4-6).
# ANTHROPIC_MODEL=claude-sonnet-4-6

# Optional: max output tokens for Claude (defaults to 64000). Raise/lower to
# fit the model's output limit; large page builds need a high value.
# ANTHROPIC_MAX_TOKENS=64000
