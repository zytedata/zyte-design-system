{
  "name": "zyte-design-system",
  "private": true,
  "version": "0.0.0",
  "description": "Zyte design system monorepo (dashboard + per-product packages).",
  "packageManager": "pnpm@8.15.4",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm --filter dashboard dev",
    "build": "pnpm -r --filter \"./packages/*\" build && pnpm --filter dashboard build",
    "start": "pnpm --filter dashboard start",
    "lint": "pnpm -r lint",
    "lint:fix": "pnpm -r lint:fix",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "typecheck": "pnpm -r typecheck",
    "tokens:build": "pnpm -r --filter \"./packages/{web,core,scrapy,extract-summit}\" run build:tokens",
    "tokens:check": "pnpm -r --filter \"./packages/{web,core,scrapy,extract-summit}\" run check:tokens",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "pnpm -r --filter \"./packages/*\" build && changeset publish"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^0.6.0",
    "@changesets/cli": "^2.27.10",
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "typescript": "^5"
  }
}
