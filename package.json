{
  "name": "zyte-design-system",
  "private": true,
  "version": "0.0.0",
  "description": "Zyte design system monorepo (dashboard + per-product packages).",
  "packageManager": "pnpm@8.15.4",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter dashboard dev",
    "build": "pnpm -r --filter \"./packages/*\" build && pnpm --filter dashboard build",
    "start": "pnpm --filter dashboard start",
    "lint": "pnpm -r lint",
    "lint:fix": "pnpm -r lint:fix",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "typecheck": "pnpm -r typecheck",
    "tokens:build": "pnpm -r --filter \"./packages/{web,core,scrapy,extract-summit}\" run build:tokens",
    "tokens:check": "pnpm -r --filter \"./packages/{web,core,scrapy,extract-summit}\" run check:tokens",
    "audit": "pnpm audit --audit-level moderate",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "pnpm -r --filter \"./packages/*\" build && changeset publish"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^0.7.0",
    "@changesets/cli": "^2.31.1",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript": "^6.0.3"
  },
  "pnpm": {
    "overrides": {
      "ip-address": "^10.7.4",
      "postcss": "^8.5.10",
      "hono": ">=4.13.11",
      "js-yaml": "^4.2.0",
      "read-yaml-file": "^2.1.0",
      "@babel/core": "^7.29.6",
      "brace-expansion@>=5.0.0 <5.0.6": ">=5.0.6",
      "proxy-addr@<2.0.8": "^2.0.8",
      "fast-uri@<3.1.9": "^3.1.9",
      "brace-expansion@<1.1.21": "^1.1.21",
      "brace-expansion@>=4.0.0 <5.0.12": "^5.0.12",
      "source-map-js@<1.2.2": "^1.2.2",
      "zod@<4.6.6": "^4.6.6",
      "body-parser@<2.4.0": "^2.4.0",
      "qs@<6.16.0": "^6.16.0"
    },
    "auditConfig": {
      "ignoreCves": [
        "CVE-2026-53550"
      ],
      "ignoreGhsas": [
        "GHSA-h67p-54hq-rp68"
      ]
    }
  }
}
